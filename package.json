{
  "name": "pixel-invaders",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.2",
    "effect": "3.22.1",
    "solid-js": "2.0.0-rc.2"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.32",
    "@types/node": "26.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tsx": "4.23.12",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}
